        <mxCell id="note-decision" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#f08c00;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;" value="Ranh giới quyền quyết định&#10;&#10;AGENT trả về bằng chứng: score, confidence, misconception_code, và hai cờ cho biết đáp án có mâu thuẫn với cách làm hay không và có đủ căn cứ hay không.&#10;&#10;BE, trong be/review_policy.py, mới so ngưỡng và sinh needs_teacher_review cùng review_reason. Nếu để AGENT tự quyết, cổng teacher-in-the-loop sẽ nằm bên trong AI service." vertex="1">
          <mxGeometry height="150" width="620" x="620" y="960" as="geometry" />
        </mxCell>

        <mxCell id="note-fence" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#e03131;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;" value="Cơ chế giữ ranh giới&#10;&#10;Bốn service Python dùng chung một conda env, nên không có gì chặn import chéo lúc chạy.&#10;&#10;import-linter là cơ chế duy nhất còn lại, chạy tự động qua pre-commit. Nó cấm mọi chiều giữa mọi cặp trong be, agent, document, ingest — và cấm cả hai package dùng chung import ngược vào một service. Cách duy nhất biết nó còn sống là thử phá: thêm import be vào ingest, xác nhận check fail, rồi hoàn tác." vertex="1">
          <mxGeometry height="150" width="440" x="110" y="960" as="geometry" />
