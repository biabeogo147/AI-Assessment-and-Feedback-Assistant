# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# Python packaging / build
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.egg
MANIFEST

# PyCharm / JetBrains
.idea/

# VS Code
.vscode/

# FastAPI / Uvicorn runtime
*.pid
*.log
logs/

# Testing / coverage
.pytest_cache/

# Type checking / linting
.pytype/
.ruff_cache/
.mypy_cache/
.import_linter_cache/

# Node / pnpm / Vite
node_modules/
.pnpm-store/
.vite/
vite.config.ts.timestamp-*
*.tsbuildinfo

# Jupyter Notebook
.ipynb_checkpoints/

# Database / local storage
*.sqlite
*.sqlite3
*.db


# Cache / temporary files
.cache/
tmp/
temp/

# LaTeX (docs/report)
*.aux
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.synctex.gz
*.toc
*.xdv
docs/report/*.log

# Sách giáo khoa dùng để đo, và nhãn vàng của bộ đo OCR.
#
# Mười bốn cuốn SGK không phải của repo này, và chúng là 1 561 trang ảnh scan.
# Nhãn vàng ở data/gold/ thì **vô dụng khi không có chúng**, nên nó cũng ở ngoài
# git: một bộ nhãn trong repo chỉ là chữ nguyên văn SGK mà không ai chạy lại được
# bằng nó. Thứ commit được là mã benchmark, thước đo, test của thước đo, và bảng
# số trong plan.
data/
