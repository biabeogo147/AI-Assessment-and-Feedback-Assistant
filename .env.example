# Copy sang .env rồi điều chỉnh.
#
# Mọi biến ở đây phải được be/config.py hoặc agent/config.py đọc tới. Đây không
# phải một lời mong: tools/check_contract.py đỏ nếu một biến được khai ở đây mà
# không ai đọc. Một biến không ai đọc còn tệ hơn một biến thiếu -- nó nói với
# người đọc sau rằng có một cái núm, mà xoay thì không gì xảy ra.

# Dùng chung: ba thứ hạ tầng chạy trong Docker -- Redis, Postgres và MinIO.
#
# Dùng 127.0.0.1, không dùng localhost. Trên Windows, localhost phân giải ra
# ::1 trước 127.0.0.1, và địa chỉ IPv6 mà Docker Desktop publish không nhận
# kết nối -- client đợi hết timeout rồi service chết lúc khởi động.
# Test-NetConnection của PowerShell che mất lỗi này vì nó tự fallback sang
# IPv4.
REDIS_URL=redis://127.0.0.1:6379/0

# Tên queue cả hai bên thống nhất. BE đẩy job vào, AGENT lấy job ra.
AGENT_QUEUE_NAME=aiafa:grading

# Hai queue của vòng xử lý tài liệu, đặt tên theo **bên tiêu thụ**. Đặt theo
# công việc là đúng cái cách aiafa:grading mục ruỗng -- tên ấy nói về chấm bài
# và nay chở bảy task, sáu cái không phải chấm bài. Một queue thì chỉ có một
# worker đứng sau, nên tên nói về bên tiêu thụ không bao giờ hết đúng.
DOCUMENT_QUEUE_NAME=aiafa:document
INGEST_QUEUE_NAME=aiafa:ingest

# arq giữ kết quả một job lại bao lâu để BE đọc về, tính bằng giây.
JOB_RESULT_TTL_SECONDS=3600

# Một tài liệu đứng ở trạng thái 'đang xử lý' bao lâu thì BE coi là job đã
# chết, tính bằng giây. BE đọc, và nó **suy ra lúc đọc** chứ không ghi gì --
# một process đi canh những process đã chết thì cũng chết được y như vậy.
# Rộng vì lý do đo được: quét 29 trang mất 31 ms, nên năm phút không phải để
# chờ việc mà để phủ một worker khởi động nguội và một hàng job đang dồn.
DOCUMENT_STALE_AFTER_SECONDS=300

# Mức Confidence mà từ đó trở xuống một bài đã chấm bị đưa vào Teacher Review
# Queue. Thuộc BE: AGENT báo confidence nhưng không bao giờ hành động theo nó.
REVIEW_CONFIDENCE_THRESHOLD=0.7

# Nơi BE giữ state của Attempt. ADR-21: một hạn vào của pha 2 còn cách hàng giờ
# hoặc hàng ngày, nên đây là một database thật, không phải một cache có hạn sống.
DATABASE_URL=postgresql+asyncpg://aiafa:aiafa@127.0.0.1:5432/aiafa

# Nơi byte của tài liệu giáo viên thật sự nằm. Chúng rời cột LargeBinary của
# Postgres vì services/document -- service đọc tệp -- không có credential
# database, nên nó không với tới được một cột.
#
# Endpoint là host:port **không có scheme**: SDK minio muốn vậy, và nó nhận
# scheme qua MINIO_SECURE. Giá trị phải khớp bằng tay với MINIO_ROOT_USER và
# MINIO_ROOT_PASSWORD trong docker-compose.infra.yml -- hai cái tên ấy do image
# quy định nên không đổi được cho giống nhau.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=aiafa
MINIO_SECRET_KEY=aiafa-local-dev
# Tên bucket phải hợp lệ với DNS: chữ thường, 3-63 ký tự, không gạch dưới.
MINIO_BUCKET=aiafa-documents
# TLS. Local thì không; ngày lên S3 thật thì bật.
MINIO_SECURE=false

# Đứng thay cho màn hình đăng nhập, thứ mà ADR-10 để ra ngoài vòng đầu. Một
# request nói mình là ai bằng "X-Actor: student:HS2026-1204". Phân quyền thì
# thật trong cả hai trường hợp -- chỉ phần chứng minh danh tính là tạm. Tắt nó
# đi khi ra khỏi môi trường dev.
DEV_IDENTITY_ENABLED=true

# BE chờ một job của AGENT bao lâu trước khi bỏ cuộc, tính bằng giây. Phải phủ
# được cả một job, kể cả mọi lần retry bên trong nó.
AGENT_JOB_TIMEOUT_SECONDS=70

# -------------------------------------------------------------------- model
#
# Chỉ AGENT đọc mấy biến này. BE không bao giờ giữ credential của một model --
# đó chính là lý do agent/llm.py là module duy nhất biết công ty nào đang trả
# lời.

# False thì giữ nguyên nội dung dựng sẵn mà các handler vẫn trả về từ trước.
# Bật lên khi đã có một model id và một key; tắt đi để demo mà không tốn tiền.
LLM_ENABLED=false

# Tên provider mà LangChain hiểu, và model id ở provider đó. Không có giá trị
# mặc định nào hợp lý cho id: một id sai là một lời gọi thất bại.
LLM_PROVIDER=openai
LLM_MODEL=

# Được thử khi provider thứ nhất raise. Để trống thì không có fallback.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# Trần của một lời gọi model, tính bằng giây, và số lời gọi một job được phép
# làm trước khi bỏ cuộc. Tích của hai số phải nằm dưới
# AGENT_JOB_TIMEOUT_SECONDS -- tools/check_contract.py thi hành điều đó, vì một
# model chậm mà BE đã bỏ cuộc là hình dạng thất bại tệ nhất: học sinh thấy một
# lỗi cho một câu trả lời rồi sẽ về và bị ném đi.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=3

# Credential. Giá trị thật thuộc về .env, file mà git bỏ qua -- không bao giờ ở
# đây.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Stream của chat chịu được bao lâu không nghe thấy gì, tính bằng giây. BE đọc.
# Tách khỏi AGENT_JOB_TIMEOUT_SECONDS vì một lượt kèm học là một lời gọi model,
# còn viết câu hỏi cho một vòng thì là nhiều lời gọi, và một học sinh đang nhìn
# khung chat không nên phải đợi hết cái ngân sách dài hơn ấy.
STREAM_SILENCE_TIMEOUT_SECONDS=25

# Một lượt trong khung chat của giáo viên được hỏi AGENT "làm gì tiếp" bao nhiêu
# lần. BE đọc. Model tự chọn vòng lặp của nó dài bao nhiêu, nên đây là thứ duy
# nhất đứng giữa một model đang loay hoay và một hoá đơn không có trần.
MAX_TOOL_STEPS=8

# Một lượt của khung chat đó được phép mất tổng cộng bao lâu, tính bằng giây. BE
# đọc. Cần có vì MAX_TOOL_STEPS không phải một lời hứa về việc chờ: tám bước,
# mỗi bước AGENT_JOB_TIMEOUT_SECONDS, là hơn chín phút, mà một proxy hay một
# browser đã ngắt kết nối từ lâu trước đó trong khi BE ghi log một lần thành
# công.
TURN_BUDGET_SECONDS=90

# Mức log của cây logger `be.*` và `ingest.*`. Cả hai service đọc, và mỗi bên
# cấu hình cây của chính nó. INFO là mặc định vì đúng những dòng cần nhất khi
# truy một đề thiếu câu -- *vì sao* một câu bị loại -- nằm ở mức đó; hạ xuống
# WARNING là tự bịt mắt mình.
#
# Dòng này sinh ra ở plan 2c, sau một phép đo: `be/worker.py` từng hardcode INFO,
# nên biến này chỉ có tác dụng ở một trong hai process và không chỗ nào nói ra.
# Cổng chống orphan chỉ chạy một chiều -- khai rồi có ai đọc không -- nên nó
# không bao giờ bắt được chiều ngược: một trường config không ai khai ở đây.
LOG_LEVEL=INFO
