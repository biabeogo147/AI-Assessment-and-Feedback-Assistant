# Copy to .env and adjust.
#
# Every variable here must be read by be/config.py or agent/config.py. This is
# not a wish: tools/check_contract.py fails if a variable is declared here and
# nothing reads it. A variable nobody reads is worse than a missing one -- it
# tells the next reader a knob exists when turning it does nothing.

# Shared: Redis is the only infrastructure the MVP depends on.
#
# Use 127.0.0.1, not localhost. On Windows, localhost resolves to ::1 before
# 127.0.0.1, and the IPv6 address Docker Desktop publishes does not accept
# connections -- the client then waits out its timeout and the service dies at
# startup. PowerShell's Test-NetConnection hides this because it falls back to
# IPv4 on its own.
REDIS_URL=redis://127.0.0.1:6379/0

# Queue name both sides agree on. BE enqueues into it, AGENT consumes from it.
AGENT_QUEUE_NAME=aiafa:grading

# How long arq keeps a job result available for BE to read back, in seconds.
JOB_RESULT_TTL_SECONDS=3600

# Confidence at or below which a graded submission is routed to the Teacher
# Review Queue. Owned by BE: AGENT reports confidence but never acts on it.
REVIEW_CONFIDENCE_THRESHOLD=0.7

# Where BE keeps attempt state. ADR-21: a phase 2 deadline is hours or days
# away, so this is a real database and not a cache with a lifetime.
DATABASE_URL=postgresql+asyncpg://aiafa:aiafa@127.0.0.1:5432/aiafa

# Stand-in for a sign-in screen, which ADR-10 left out of scope. A request says
# who it is with "X-Actor: student:HS2026-1204". Authorisation is real either
# way -- only the proof of identity is temporary. Turn this off outside dev.
DEV_IDENTITY_ENABLED=true

# How long BE waits for an AGENT job before giving up on it, in seconds.
AGENT_JOB_TIMEOUT_SECONDS=30
