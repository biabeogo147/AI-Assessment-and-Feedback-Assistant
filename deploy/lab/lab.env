# Cấu hình **không bí mật** của lab, chung cho mọi process Python. Ý nghĩa từng biến: .env.example
# -- file này chỉ ghi giá trị khác của lab, và mọi khoá ở đây phải có ở đó
# (`tools/tests/test_lab_deploy.py`).
#
# Không có mật khẩu, URL kèm mật khẩu hay khoá API nào ở đây: chúng đến từ SSM qua
# `render-env.sh` và đi vào **từng service** ở `docker-compose.lab.yml`, để AGENT không cầm URL
# database và BE không cầm khoá model -- y như ranh giới giữa các service ở máy dev.

REDIS_URL=redis://redis:6379/0
AGENT_QUEUE_NAME=aiafa:grading
DOCUMENT_QUEUE_NAME=aiafa:document
INGEST_QUEUE_NAME=aiafa:ingest
DOCUMENT_INDEX_QUEUE_NAME=aiafa:document-index
JOB_RESULT_TTL_SECONDS=3600
DOCUMENT_STALE_AFTER_SECONDS=300

MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=aiafa-documents
# MinIO nằm trong mạng nội bộ của compose, không ra ngoài: TLS dừng ở Caddy.
MINIO_SECURE=false
MONGO_DATABASE=aiafa_content

# Máy lab có 2 vCPU.
OCR_PAGES_PER_JOB=10
OCR_READER=easyocr
OCR_THREADS=2

JEV_MODEL=jev-1.13.0
JEV_MIN_CONFIDENCE=0.8
JEV_CONCURRENCY=16
JEV_TIMEOUT_SECONDS=20
LLM_CONCURRENCY=8
# Lab chỉ cần một khoá model: Claude cho cả Kriky, tóm tắt mục lục lẫn đọc banner.
SUMMARY_PROVIDER=anthropic
SUMMARY_MODEL=claude-haiku-5-5
BANNER_PROVIDER=anthropic
BANNER_MODEL=claude-haiku-5-5

DEV_IDENTITY_ENABLED=false
DEV_IDENTITY_HEADER=X-Actor
TEACHER_SIGN_UP_ENABLED=false
SESSION_COOKIE_SECURE=true

AGENT_JOB_TIMEOUT_SECONDS=70
LLM_ENABLED=true
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_THINKING=disabled
LLM_EFFORT=low
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=3
SKILL_MIN_YES=0.3
SKILL_ROUTER_TIMEOUT_SECONDS=3

STREAM_SILENCE_TIMEOUT_SECONDS=25
MAX_TOOL_STEPS=8
READ_STEP_SECONDS=10
TURN_BUDGET_SECONDS=90
TURN_LOCK_STALE_SECONDS=600
LOG_LEVEL=INFO
